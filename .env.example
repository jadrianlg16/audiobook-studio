# Copy to `.env` and adjust. All values have sane defaults.

# Host ports
GATEWAY_PORT=8080
FRONTEND_PORT=5173
# The studio API. The UI (Director's Desk) is on FRONTEND_PORT — that is the
# front door; this port is the API and its /docs.
STUDIO_PORT=5174

# Where engines cache downloaded model weights on the host (bind-mounted).
# Point this at a disk with plenty of space — checkpoints are multi-GB.
HF_CACHE_DIR=./hf-cache

# Optional: override engine discovery. Format: "id=url;id=url".
# Leave blank to use the defaults wired in docker-compose.yml.
ENGINES=

# Max engines synthesized in parallel during a bake-off. On a single GPU keep
# this at 1 so concurrent model loads don't exhaust VRAM.
BAKEOFF_CONCURRENCY=1

# Low-VRAM mode: free each engine's model after its bake-off synth, so several
# heavy GPU engines can bake off one-at-a-time on a small card (e.g. 8 GB).
# Set to 1 with BAKEOFF_CONCURRENCY=1 on an 8 GB GPU. Costs a model reload per
# bake-off run. Leave 0 if you have plenty of VRAM.
BAKEOFF_UNLOAD=1

# HuggingFace token (only needed for gated models; most here are open).
HUGGING_FACE_HUB_TOKEN=

# AI director (LLM that reads text -> emotion/voice direction).
# Ollama running on the host; the gateway reaches it via host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
# Optional Gemini key (the UI can also supply it per-request). Free model:
# gemini-flash-latest (Gemini 3 Flash).
GEMINI_API_KEY=

# Which local Ollama model the UI pre-fills as the director. Per-machine: an
# 8 GB box wants an 8-12B model, a big box can afford 27-30B. The UI field stays
# editable — this is only the default, so moving machines is a one-line change.
DIRECTOR_MODEL=gemma3:12b

# Optional: point the director at a variant prompt file to A/B it. Blank uses
# the built-in gateway/app/prompts/director.md (which hot-reloads on save).
DIRECTOR_PROMPT_PATH=

# --- Audiobook Studio (service `studio`, the Director's Desk) ----------------
# Two no-model switches. They are not stubs bolted on the side: offline swaps
# the synth callable and fake-director swaps the annotate callable, so the job
# kinds, the pass shapes and the cache keys are the real ones. That is what lets
# the whole UI be exercised end to end with no GPU and no LLM.
#   1 = fake synth (no gateway, no engine); 0 = the real engines.
STUDIO_OFFLINE=0
#   1 = canned, deterministic direction (no LLM); 0 = the real director.
STUDIO_FAKE_DIRECTOR=0

# Defaults for a new book. All three are editable in the UI's Settings screen;
# these only decide what a fresh install starts with.
#   narrator_only      everyone on the narrator engine (publishable)
#   dialogue_expressive  narrator on Kokoro, characters on the expressive engine
#   all_expressive     everyone on the expressive engine
# ⚠️ Anything that routes a line to `breeze` makes the book non-commercial; the
# studio surfaces a licence note on the shelf and the desk when it does.
# `qwen3tts` (GPU profile) is the other engine that takes a written note, with
# Apache-2.0 weights — set STUDIO_EXPRESSIVE_ENGINE=qwen3tts for a directable
# book you can publish. Hybrid casting gives an expressive character a voice
# *description* rather than one of its nine named voices; pick those in the cast.
STUDIO_NARRATOR_ENGINE=kokoro
STUDIO_EXPRESSIVE_ENGINE=breeze
STUDIO_CASTING_MODE=narrator_only

# The path prefix a browser uses to reach the studio. The frontend's nginx
# proxies /studio/ and strips it before the studio sees the request, so URLs the
# API hands back (a line's audio, an export file) have to carry the prefix; the
# service answers on both, so the same URL works on :5174 too. Set it empty only
# for a deployment that puts the studio at the root with no proxy in front.
STUDIO_URL_PREFIX=/studio

# --- Breeze TTS 2 (engine `breeze`, GPU profile) -----------------------------
# ⚠️ Weights are research/non-commercial; that covers self-hosted output too.
# Evaluation only — BreezeBlue's hosted API is the commercial path.
# Download the checkpoint once (~6 GB):
#   huggingface-cli download BreezeBlue/Breeze-TTS-2 --local-dir ./models/breeze-tts-2
#
# Blank = spawn breeze_infer.api inside the container (needs ~7.7 GiB VRAM;
# upstream recommends 12 GB). Set it to e.g. http://gpu-host:7860 to drive a
# Breeze server running on a bigger machine while the adapter stays here.
BREEZE_SERVER_URL=
# 1 = --fast-all: roughly 2x faster, but ~14.4 GiB VRAM instead of ~7.7 GiB.
BREEZE_FAST=0
# Inline vocal events the director is allowed to insert. Default is the four the
# open weights attest: (laugh),(cough),(clears throat),(sigh). Upstream says
# "such as", so widen it only with tags you have A/B'd on your own checkpoint.
# A Chinese book needs the square-bracket forms: [笑],[咳嗽],[清嗓子],[叹气]
# BREEZE_AUDIO_TAGS=(laugh),(cough),(clears throat),(sigh)
#
# Note: the upstream server handles ONE request at a time and answers HTTP 409 to
# a second. Serialize, or run one server per concurrent request.

# --- Qwen3-TTS (engine `qwen3tts`, GPU profile) ------------------------------
# Apache-2.0 weights. Nine named voices + a written note (`instruct`). Weights
# (~4.5 GB) download into HF_CACHE_DIR on first use, or once ahead with:
#   docker compose --profile gpu run --rm --no-deps --entrypoint hf qwen3tts download Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Any CustomVoice checkpoint: an HF repo id, or a directory the container can see
# (e.g. under /cache). The 0.6B one ignores notes.
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# The voice used when a request names none (aiden = US male, English native).
QWEN_TTS_DEFAULT_VOICE=aiden
